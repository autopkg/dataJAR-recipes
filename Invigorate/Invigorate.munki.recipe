<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest version of Invigorate and imports it into Munki.

The minimum_os_version is derived via MunkiInstallsItemsCreator by default, which requires a minimum AutoPkg version of 2.7 please update if you're not already running it. Set the DERIVE_MIN_OS variable to an empty string to disable this.</string>
    <key>Identifier</key>
    <string>com.github.dataJAR-recipes.munki.Invigorate</string>
    <key>Input</key>
    <dict>
        <key>DERIVE_MIN_OS</key>
        <string>YES</string>
        <key>NAME</key>
        <string>Invigorate</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>pkginfo</key>
        <dict>
            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
            <key>description</key>
            <string>Invigorate is a unique dynamics processor purpose built to add glue and life to your mix, drum bus, or any other element. The intuitive radar control allows a seamless transition from energetic compression, through aggressive limiting, to rich overdrive; gluing your mix and giving it presence.
The result brings your mix forward and gives it the energy you need for a finished record.</string>
            <key>developer</key>
            <string>Newfangled Audio</string>
            <key>display_name</key>
            <string>Invigorate</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>unattended_install</key>
            <true/>
            <key>unattended_uninstall</key>
            <true/>
            <key>uninstall_method</key>
            <string>uninstall_script</string>
            <key>uninstall_script</key>
            <string>#!/bin/zsh --no-rcs

# Uninstall script for Newfangled Audio Invigorate.
# Intentionally left in place: the user's Music folder (user space) and the shared
# A.L. licensing library (/usr/local/lib/libal.2.dylib and its receipt) used by other Newfangled Audio products.

# Exit codes:
# 0 = Success
# 1 = Error during removal

uninstall_paths=(
    "/Library/Audio/Plug-Ins/Components/Invigorate.component"
    "/Library/Audio/Plug-Ins/VST/Newfangled Audio/Invigorate.vst"
    "/Library/Audio/Plug-Ins/VST3/Newfangled Audio/Invigorate.vst3"
    "/Library/Application Support/Avid/Audio/Plug-Ins/Newfangled Audio/Invigorate.aaxplugin"
    "/Library/Application Support/Newfangled Audio/Invigorate"
    "/Users/Shared/Newfangled Audio/Invigorate"
)

exit_status=0

# Removes a path if it exists
remove_if_exists() {
    local target_path="$1"
    if [[ -e "${target_path}" ]]; then
        echo "Removing: ${target_path}"
        if ! /bin/rm -rf "${target_path}"; then
            echo "Error: Failed to remove ${target_path}"
            exit_status=1
        fi
    else
        echo "Path not found (skipping): ${target_path}"
    fi
}

for target_path in "${uninstall_paths[@]}"; do
    remove_if_exists "${target_path}"
done

# Forget the package receipts (the vendor's installer receipts and the receipt created by the earlier
# recipe-built pkg) so receipt-based Extension Attributes stop reporting a version once Invigorate is
# gone. The shared A.L. licensing receipt (com.newfangledaudio.libal.pkg) is intentionally kept.
# Listing the receipts is a separate step so a pkgutil failure isn't mistaken for "no matching receipts".
if ! all_receipts=$(/usr/sbin/pkgutil --pkgs); then
    echo "Error: Failed to list package receipts"
    exit_status=1
fi
installed_receipts=$(echo "${all_receipts}" | /usr/bin/grep -E '^(com\.newfangledaudio\.pkg\.invigorate\.|com\.Eventide\.Invigorate$)')

for receipt_id in ${(f)installed_receipts}; do
    echo "Forgetting receipt: ${receipt_id}"
    if ! /usr/sbin/pkgutil --forget "${receipt_id}"; then
        echo "Error: Failed to forget ${receipt_id}"
        exit_status=1
    fi
done

exit ${exit_status}</string>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>2.7</string>
    <key>ParentRecipe</key>
    <string>com.github.dataJAR-recipes.pkg.Invigorate</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/unpacked</string>
                <key>flat_pkg_path</key>
                <string>%RECIPE_CACHE_DIR%/%NAME%.pkg</string>
                <key>purge_destination</key>
                <true/>
            </dict>
            <key>Processor</key>
            <string>FlatPkgUnpacker</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/payload/Library/Audio/Plug-Ins/Components</string>
                <key>pkg_payload_path</key>
                <string>%RECIPE_CACHE_DIR%/unpacked/Invigorate-au.pkg/Payload</string>
                <key>purge_destination</key>
                <true/>
            </dict>
            <key>Processor</key>
            <string>PkgPayloadUnpacker</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>derive_minimum_os_version</key>
                <string>%DERIVE_MIN_OS%</string>
                <key>faux_root</key>
                <string>%RECIPE_CACHE_DIR%/payload</string>
                <key>installs_item_paths</key>
                <array>
                    <string>/Library/Audio/Plug-Ins/Components/Invigorate.component</string>
                </array>
                <key>version_comparison_key</key>
                <string>CFBundleShortVersionString</string>
            </dict>
            <key>Processor</key>
            <string>MunkiInstallsItemsCreator</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>MunkiPkginfoMerger</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>input_plist_path</key>
                <string>%RECIPE_CACHE_DIR%/payload/Library/Audio/Plug-Ins/Components/Invigorate.component/Contents/Info.plist</string>
                <key>plist_version_key</key>
                <string>CFBundleShortVersionString</string>
            </dict>
            <key>Processor</key>
            <string>Versioner</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>additional_pkginfo</key>
                <dict>
                    <key>version</key>
                    <string>%version%</string>
                </dict>
            </dict>
            <key>Processor</key>
            <string>MunkiPkginfoMerger</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pkg_path%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>path_list</key>
                <array>
                    <string>%RECIPE_CACHE_DIR%/%NAME%.pkg</string>
                    <string>%RECIPE_CACHE_DIR%/payload</string>
                    <string>%RECIPE_CACHE_DIR%/unpacked</string>
                </array>
            </dict>
            <key>Processor</key>
            <string>PathDeleter</string>
        </dict>
    </array>
</dict>
</plist>
