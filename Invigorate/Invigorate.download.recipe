<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest version of Invigorate. The vendor ships a signed and notarized distribution pkg inside the DMG, so CodeSignatureVerifier uses expected_authority_names (pkgutil --check-signature). Team ID 3D7FTVTH7L is enforced via the Developer ID Installer authority name. Before 1.5.5 the DMG contained an InstallBuilder app instead.</string>
    <key>Identifier</key>
    <string>com.github.dataJAR-recipes.download.Invigorate</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Invigorate</string>
    </dict>
    <key>MinimumVersion</key>
    <string>1.1</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>filename</key>
                <string>Invigorate.dmg</string>
                <key>url</key>
                <string>https://www.eventideaudio.com/downloads/invigorate-installer-mac-64-bit</string>
            </dict>
            <key>Processor</key>
            <string>URLDownloader</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pattern</key>
                <string>%pathname%/*.pkg</string>
            </dict>
            <key>Processor</key>
            <string>FileFinder</string>
        </dict>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>expected_authority_names</key>
                <array>
                    <string>Developer ID Installer: Orthogonal Art and Science, LLC (3D7FTVTH7L)</string>
                    <string>Developer ID Certification Authority</string>
                    <string>Apple Root CA</string>
                </array>
                <key>input_path</key>
                <string>%pathname%/%found_basename%</string>
            </dict>
            <key>Processor</key>
            <string>CodeSignatureVerifier</string>
        </dict>
    </array>
</dict>
</plist>
