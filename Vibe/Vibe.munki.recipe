<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest version of Vibe and imports it into Munki.

The DMG contains a single drag-and-drop vibe.app, so MunkiImporter is used on its own: it generates the installs array, the copy_from_dmg installer_type, items_to_copy and minimum_os_version from the app itself.

For Intel use: "x86_64" in the SUPPORTED_ARCH variable
For Apple Silicon use: "arm64" in the SUPPORTED_ARCH variable

SUPPORTED_ARCH must be changed together with DOWNLOAD_ARCH in the download recipe (arm64 = aarch64, x86_64 = x64).</string>
    <key>Identifier</key>
    <string>com.github.dataJAR-recipes.munki.Vibe</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Vibe</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>SUPPORTED_ARCH</key>
        <string>arm64</string>
        <key>pkginfo</key>
        <dict>
            <key>blocking_applications</key>
            <array>
                <string>vibe.app</string>
            </array>
            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
            <key>description</key>
            <string>Vibe transcribes audio and video to text locally on your Mac using OpenAI Whisper, with no data leaving your device.</string>
            <key>developer</key>
            <string>Jacob Kolani</string>
            <key>display_name</key>
            <string>Vibe</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>supported_architectures</key>
            <array>
                <string>%SUPPORTED_ARCH%</string>
            </array>
            <key>unattended_install</key>
            <true/>
            <key>unattended_uninstall</key>
            <true/>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>1.1</string>
    <key>ParentRecipe</key>
    <string>com.github.dataJAR-recipes.download.Vibe</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
    </array>
</dict>
</plist>
